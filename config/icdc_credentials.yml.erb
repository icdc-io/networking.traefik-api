---
environment:
  development:
    compute:
      url: <%= ENV['COMPUTE_DEV_URL'] %>
      login: admin
      password: <%= ENV['COMPUTE_PASSWORD'] %>
      token: <%= ENV['COMPUTE_TOKEN'] %>
  production:
    compute:
      url: https://compute.<%= ENV['LOCATION_NAME'] %>.<%= ENV['CPV_NAME'] %>.io
      login: admin
      password: <%= ENV['COMPUTE_PASSWORD'] %>
      token: <%= ENV['COMPUTE_TOKEN'] %>